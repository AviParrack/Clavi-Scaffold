.DS_Store
node_modules/
*.local
__pycache__/
.gstack/

# Claude Code local state (per-machine, not shared)
.claude/settings.local.json
.claude/projects/
.claude/memory/

# Symlinked skill packs — regenerated by /crossroads-add (don't commit dangling symlinks)
.claude/skills/sci-*
.claude/skills/gstack-*
.claude/skills/acad-*
.claude/skills/tob-*

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.secrets.baseline

# Sensitive personal folders — never track (extend as needed)
Town-Hall/User/Finance/
Town-Hall/User/Life Admin/Finance/

# Per-machine runtime artifacts from autodesk + scout cron
Harbor/Dispatch/log/builders/*.log
Harbor/Dispatch/log/scouts/*.log
Harbor/Dispatch/log/builders/manager.log

# Large media files (>100MB GitHub hard limit; >50MB warning)
*.mp4
*.mov
*.pptx

# Submodules / shared repos with their own remotes — push separately
# (uncomment + adjust paths for your scaffold's submodules)
# Crossroads/forethought-starter/
# Crossroads/clavi-scaffold/
